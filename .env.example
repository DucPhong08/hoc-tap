# Application
BE_MODE=development
BE_APP_API_PREFIX=api

BE_APP_APP_NAME=hoc-tap
BE_APP_APP_VERSION=0.0.1
BE_AUTH_BCRYPT_ROUNDS = 

# Host
BE_HOST_HOST=localhost
BE_HOST_PORT=3000

# SQL profile (used by any context mapped to "sql")
# SQL_TYPE=postgres
# SQL_HOST=localhost
# SQL_PORT=5432
# SQL_USER=postgres
# SQL_PASSWORD=postgres
# SQL_DB=mydb
# SQL_SCHEMA=public

# Mongo profile (used by any context mapped to "mongo")
DB_URI=mongodb://localhost:27017/
BE_DATABASES_MAIN_PROFILE=mongo

# Main DB dev flags (keep)
BE_DATABASES_MAIN_DEV_AUTOMIGRATE=true
BE_DATABASES_MAIN_DEV_AUTOSYNCSCHEMA=false
BE_DATABASES_MAIN_DEV_DEBUG=true

# Auth
BE_AUTH_JWT_SECRET=your-secret-key-here
BE_AUTH_JWT_EXPIRES_IN=1d
BE_AUTH_JWT_REFRESH_SECRET=your-refresh-secret-key
BE_AUTH_JWT_REFRESH_EXPIRES_IN=7d

# OAuth
BE_OAUTH_GOOGLE_CLIENT_ID=
BE_OAUTH_GOOGLE_CLIENT_SECRET=
BE_OAUTH_GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

BE_OAUTH_FACEBOOK_APP_ID=
BE_OAUTH_FACEBOOK_APP_SECRET=
BE_OAUTH_FACEBOOK_CALLBACK_URL=http://localhost:3000/api/auth/facebook/callback

# CORS
BE_CORS_ORIGINS_0=http://localhost:3000

# Cache Configuration
CACHE_ENABLED=false
CACHE_TTL=300
CACHE_PREFIX=myapp
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

