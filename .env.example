# Application
BE_MODE=development
BE_APP_API_PREFIX=api

# Host
BE_HOST_HOST=localhost
BE_HOST_PORT=3000

# Database
BE_DATABASES_MAIN_CONNECTION_CONNECTION=postgresql
BE_DATABASES_MAIN_CONNECTION_HOST=localhost
BE_DATABASES_MAIN_CONNECTION_PORT=5432
BE_DATABASES_MAIN_CONNECTION_DATABASE=mydb
BE_DATABASES_MAIN_CONNECTION_USER=postgres
BE_DATABASES_MAIN_CONNECTION_PASSWORD=postgres
BE_DATABASES_MAIN_DEV_AUTOMIGRATE=true
BE_DATABASES_MAIN_DEV_AUTOSYNCSCHEMA=false
BE_DATABASES_MAIN_DEV_DEBUG=true
BE_DATABASES_MAIN_ORM_MIGRATIONS_PATH=dist/migrations
BE_DATABASES_MAIN_ORM_MIGRATIONS_PATH_TS=src/migrations

# Auth
BE_AUTH_JWT_SECRET=your-secret-key-here
BE_AUTH_JWT_EXPIRES_IN=1d
BE_AUTH_JWT_REFRESH_SECRET=your-refresh-secret-key
BE_AUTH_JWT_REFRESH_EXPIRES_IN=7d

# OAuth
BE_OAUTH_GOOGLE_CLIENT_ID=
BE_OAUTH_GOOGLE_CLIENT_SECRET=
BE_OAUTH_GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

BE_OAUTH_FACEBOOK_APP_ID=
BE_OAUTH_FACEBOOK_APP_SECRET=
BE_OAUTH_FACEBOOK_CALLBACK_URL=http://localhost:3000/api/auth/facebook/callback

# CORS
BE_CORS_ORIGINS_0=http://localhost:3000
BE_CORS_ORIGINS_1=http://localhost:3001

# Swagger
BE_SWAGGER_ENABLED=true
BE_SWAGGER_TITLE=API Documentation
BE_SWAGGER_DESCRIPTION=API Documentation
BE_SWAGGER_VERSION=1.0
BE_SWAGGER_PATH=api

# Validation
BE_VALIDATION_WHITELIST=true
BE_VALIDATION_FORBID_NON_WHITELISTED=true
BE_VALIDATION_TRANSFORM=true

# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL=300
CACHE_PREFIX=myapp
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Cluster Configuration
CLUSTER_ENABLED=false
CLUSTER_WORKERS=0
