# Application
MODE=development
API_PREFIX=api
APP_NAME=hoc-tap
APP_VERSION=0.0.1
APP_TIMEZONE=+07:00

# Host
HOST=localhost
PORT=3000

# Database
DB_MAIN_DRIVER=postgresql
DB_MAIN_PROFILE=sql
DB_MAIN_HOST=localhost
DB_MAIN_PORT=5432
DB_MAIN_USERNAME=postgres
DB_MAIN_PASSWORD=postgres
DB_MAIN_DATABASE=mydb
DB_MAIN_SCHEMA=public
# DB_MAIN_URI=mongodb://localhost:27017/hoc-tap
DB_MAIN_DEBUG=true
DB_MAIN_AUTO_MIGRATE=false
DB_MAIN_MIGRATIONS_PATH=mikro-base/migrations
DB_MAIN_POOL_MIN=2
DB_MAIN_POOL_MAX=10
DB_MAIN_TIMEZONE=+07:00

# Auth
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/auth/facebook/callback

# Swagger
SWAGGER_ENABLED=true
SWAGGER_TITLE=API Documentation
SWAGGER_DESCRIPTION=API Documentation
SWAGGER_VERSION=1.0
SWAGGER_PATH=api

# Validation
VALIDATION_WHITELIST=true
VALIDATION_FORBID_NON_WHITELISTED=true
VALIDATION_TRANSFORM=true

# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL=300
CACHE_PREFIX=myapp
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
