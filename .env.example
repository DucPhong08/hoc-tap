BE_MODE=development

# App Config
BE_APP_APIPREFIX=api
BE_APP_APPNAME=Hoc Tap API
BE_APP_APPVERSION=1.0.0
BE_APP_TIMEZONE=+07:00

# Host Config
BE_HOST_HOST=0.0.0.0
BE_HOST_PORT=3000

BE_CORS_ORIGINS_0=http://localhost:3000

# Auth Config
BE_AUTH_JWTSECRET=your-super-secret-jwt-key-change-in-production
BE_AUTH_JWTEXPIRESIN=1h
BE_AUTH_JWTREFRESHSECRET=your-super-secret-refresh-key-change-in-production
BE_AUTH_JWTREFRESHEXPIRESIN=7d
BE_AUTH_BCRYPTROUNDS=10

# Swagger Config
BE_SWAGGER_ENABLED=true
BE_SWAGGER_PATH=api
BE_SWAGGER_TITLE=Hoc Tap API
BE_SWAGGER_DESCRIPTION=NestJS Clean Architecture Boilerplate with MikroORM
BE_SWAGGER_VERSION=1.0

# Validation Config
BE_VALIDATION_WHITELIST=true
BE_VALIDATION_FORBIDNONWHITELISTED=true
BE_VALIDATION_TRANSFORM=true

# PostgreSQL Configuration
BE_DATABASES_MAIN_CONNECTION_CONNECTION=postgresql
BE_DATABASES_MAIN_CONNECTION_HOST=localhost
BE_DATABASES_MAIN_CONNECTION_PORT=5432
BE_DATABASES_MAIN_CONNECTION_USER=postgres
BE_DATABASES_MAIN_CONNECTION_PASSWORD=postgres
BE_DATABASES_MAIN_CONNECTION_DATABASE=hoctap
BE_DATABASES_MAIN_DEV_AUTOMIGRATE=true
BE_DATABASES_MAIN_DEV_DEBUG=false
BE_DATABASES_MAIN_ORM_MIGRATIONS_PATH=dist/migrations
BE_DATABASES_MAIN_ORM_MIGRATIONS_PATHTS=src/migrations

# OAuth Config
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_CALLBACK_URL=http://localhost:3000/auth/facebook/callback
