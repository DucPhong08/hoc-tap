# ==============================================================================
# MẪU FILE .ENV CHẠY TRÊN SERVER DÀNH CHO DOCKER COMPOSE
# (Lưu file này thành .env trên server và thay đổi các mật khẩu nếu cần)
# ==============================================================================

# 1. Docker Image (Kéo từ GitHub Container Registry)
DOCKER_IMAGE=ghcr.io/ducphong08/hoc-tap:develop

# 2. Ứng dụng & Môi trường
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# 3. Tài khoản khởi tạo MongoDB Root
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=matkhau123

# 4. Chuỗi kết nối Database NestJS (Phải có ?authSource=admin&directConnection=true)
DB_MAIN_URI=mongodb://admin:matkhau123@mongo:27017/hoc-tap?authSource=admin&directConnection=true
DB_LOGS_URI=mongodb://admin:matkhau123@mongo:27017/hoc-tap-logs?authSource=admin&directConnection=true

# 5. Redis Cache & Queue
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL=300
CACHE_PREFIX=app

# 6. JWT & Bảo mật (Đã sinh ngẫu nhiên an toàn để vượt qua kiểm tra Production)
JWT_SECRET=c8d4e9f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=hoc-tap-auth
JWT_AUDIENCE=hoc-tap-client
BCRYPT_ROUNDS=10
REFRESH_GRACE_PERIOD_SECONDS=15

# 7. OAuth (Nếu dùng sau này)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/auth/facebook/callback
